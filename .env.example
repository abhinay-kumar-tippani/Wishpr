# Whispr - Environment Variables Configuration

# 1. Supabase Project URL & Anon Key (Required for client & browser authentication)
# Obtain these from your Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Supabase Service Role Key (Optional / Backend only for Server Cron Cleanup API)
# WARNING: NEVER expose this key to client-side code!
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# 3. Cron Secret (Optional, for securing /api/cron/cleanup endpoint)
CRON_SECRET=your-random-cron-secret-token

# 4. App URL (Optional, defaults to window.location.origin)
NEXT_PUBLIC_APP_URL=http://localhost:3000
